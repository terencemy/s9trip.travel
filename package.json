{
  "name": "s9trip",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node dist/server.js",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --outfile=dist/server.js --external:vite --external:express && ls -R dist",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^1.45.0",
    "esbuild": "^0.27.4",
    "express": "^4.21.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "*"
  }
}
